# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Comma-separated list of allowed Telegram user IDs (bot is closed by default)
# Use /myid in Telegram to find your user ID
ALLOWED_USERS=

# Optional: Claude model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Max tokens for Claude responses (default: 4096)
MAX_TOKENS=4096
